# =============================================================================
# RHEL Image Builder for Azure - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then source it before running scripts:
#   source .env
# =============================================================================

# --- RHEL ISOs ---
# Paths to RHEL installation media (DVD or boot ISO)
RHEL9_ISO="/path/to/rhel-9.x-x86_64-dvd.iso"
RHEL10_ISO="/path/to/rhel-10.x-x86_64-boot.iso"

# --- Red Hat Subscription ---
# Option A: Activation key (preferred for automation)
RH_ORG_ID=""
RH_ACTIVATION_KEY=""

# --- Azure Service Principal ---
AZURE_CLIENT_ID=""
AZURE_PASSWORD=""
AZURE_TENANT=""
AZURE_SUBSCRIPTION=""
AZURE_RESOURCEGROUP=""

# --- Azure Storage (auto-generated if not set) ---
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_CONTAINER="vhds"
AZURE_LOCATION="eastus"

# --- Azure VM Test Configuration ---
AZURE_VM_SIZE="Standard_D2s_v6"
AZURE_ADMIN_USER="azureuser"

# --- Builder VM Credentials ---
BUILDER_PASSWORD=""          # Throwaway password for ephemeral builder VMs

# --- Build VM Configuration ---
BUILD_VM_RAM="4096"          # MB
BUILD_VM_VCPUS="2"
BUILD_VM_DISK="120"          # GB (needs space for image builds)
LIBVIRT_NETWORK="default"    # libvirt network name
