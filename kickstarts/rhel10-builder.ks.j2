#version=RHEL10
# ---------------------------------------------------------------------------
# RHEL 10 Builder VM — FIPS + STIG Hardened for image-builder
#
# Generated by Ansible from kickstarts/rhel10-builder.ks.j2
#
# FIPS compliance:
#   - fips=1 passed on installer kernel cmdline (via virt-install --extra-args)
#   - bootloader also configured with fips=1 for the installed system
#   - Per: https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/10/html/
#     security_hardening/switching-rhel-to-fips-mode
#   - Note: fips-mode-setup is removed in RHEL 10; fips=1 at install is the
#     ONLY supported method.
#
# STIG compliance:
#   - Applied via oscap --remediate in %post (not %addon, which hangs
#     when the installer itself runs in FIPS mode)
# ---------------------------------------------------------------------------

cmdline
eula --agreed
firstboot --disable

# --- Localization ---
lang en_US.UTF-8
keyboard --xlayouts='us'
timezone UTC --utc

# --- Network ---
network --bootproto=dhcp --device=link --activate --onboot=yes

# --- Authentication ---
# Dev-only throwaway password for ephemeral build VMs. SSH is switched to
# key-only auth in %post (PasswordAuthentication no), and the VMs have no
# inbound network access beyond the libvirt host.
rootpw --plaintext {{ builder_password }}
user --name=builder --password={{ builder_password }} --plaintext --groups=wheel

# --- Security ---
selinux --enforcing
firewall --enabled --service=ssh

# --- Bootloader with FIPS and audit (installed system kernel cmdline) ---
bootloader --append="fips=1 audit=1 audit_backlog_limit=8192 console=tty0 console=ttyS0,115200n8" --location=mbr

# ---------------------------------------------------------------------------
# Disk Partitioning — single root LV (builder needs max space for composes)
# Target: 120 GB virtio disk
# ---------------------------------------------------------------------------
zerombr
clearpart --all --initlabel

part biosboot  --fstype="biosboot" --size=1
part /boot     --fstype="xfs"     --size=1024
part pv.01     --fstype="lvmpv"   --grow

volgroup vg_builder pv.01

logvol /    --vgname=vg_builder --name=lv_root --fstype=xfs --size=1 --grow
logvol swap --vgname=vg_builder --name=lv_swap --fstype=swap --size=4096

# --- Installation source (DVD media) ---
cdrom

# ---------------------------------------------------------------------------
# Packages (no third-party software per FIPS requirements)
# ---------------------------------------------------------------------------
%packages
@core
image-builder
openscap-scanner
scap-security-guide
fapolicyd
aide
chrony
rsyslog
audit
policycoreutils-python-utils
bash-completion
vim-minimal
%end

# ---------------------------------------------------------------------------
# Post-install
# ---------------------------------------------------------------------------
%post --log=/root/ks-post.log
#!/bin/bash
set -x

# -- Apply STIG remediation --
# Using %post oscap --remediate instead of %addon com_redhat_oscap because
# the addon hangs when the installer kernel boots with fips=1.
oscap xccdf eval --remediate \
    --profile xccdf_org.ssgproject.content_profile_stig \
    /usr/share/xml/scap/ssg/content/ssg-rhel10-ds.xml || true

# -- Set FIPS crypto policy (RHEL 10: fips-mode-setup removed, policy follows fips=1 boot) --
update-crypto-policies --set FIPS || true

# -- Register with Red Hat (for post-install repo access) --
subscription-manager register --org="{{ rh_org_id }}" --activationkey="{{ rh_activation_key }}" || true

# -- fapolicyd: set permissive for image-builder operations --
if [ -f /etc/fapolicyd/fapolicyd.conf ]; then
    sed -i 's/^permissive.*/permissive = 1/' /etc/fapolicyd/fapolicyd.conf
fi

# -- SSH: key-only auth for builder user --
cat > /etc/ssh/sshd_config.d/99-builder.conf <<'SSHEOF'
PubkeyAuthentication yes
PasswordAuthentication no
PermitRootLogin no
SSHEOF
chmod 0600 /etc/ssh/sshd_config.d/99-builder.conf

mkdir -p /home/builder/.ssh
chmod 0700 /home/builder/.ssh
cat > /home/builder/.ssh/authorized_keys <<'KEYEOF'
{{ builder_ssh_pubkey }}
KEYEOF
chmod 0600 /home/builder/.ssh/authorized_keys
chown -R builder:builder /home/builder/.ssh
restorecon -R /home/builder/.ssh

# -- Ensure builder user has NOPASSWD sudo --
echo "builder ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/builder
chmod 0440 /etc/sudoers.d/builder

# -- Ensure firewalld allows SSH --
firewall-offline-cmd --add-service=ssh 2>/dev/null || true

# -- Enable required services --
systemctl enable sshd
systemctl enable chronyd
systemctl enable auditd
systemctl enable fapolicyd



# -- Initialize AIDE database --
aide --init
mv /var/lib/aide/aide.db.new.gz /var/lib/aide/aide.db.gz 2>/dev/null || true

echo "=== Builder VM kickstart post-install complete ==="
echo "Crypto: $(update-crypto-policies --show)"
cat /proc/sys/crypto/fips_enabled

%end

# Poweroff so virt-install --wait detects completion
poweroff
